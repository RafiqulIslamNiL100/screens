<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Screens.App.ViewModels"
             xmlns:models="using:Screens.App.Models"
             x:Class="Screens.App.Views.MainView"
             x:DataType="vm:MainViewModel">

  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+K" Command="{Binding OpenCommandPaletteCommand}"/>
  </UserControl.KeyBindings>

  <Panel Background="{DynamicResource BrushSurface}">
    <DockPanel LastChildFill="True">

      <!-- Update banner: small, dismissible, non-modal -->
      <Border Classes="updateBanner" DockPanel.Dock="Top" IsVisible="{Binding ShowUpdateBanner}">
        <StackPanel Spacing="4">
          <Grid ColumnDefinitions="*,Auto,Auto,Auto">
            <TextBlock Grid.Column="0" Text="{Binding UpdateBannerText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" IsVisible="{Binding !IsInstallingUpdate}"/>
            <TextBlock Grid.Column="0" Text="Downloading and installing — Screens will restart automatically…" VerticalAlignment="Center" IsVisible="{Binding IsInstallingUpdate}"/>
            <Button Grid.Column="1" Content="Update now" Command="{Binding InstallUpdateCommand}" Classes="secondary" Margin="8,0" IsEnabled="{Binding !IsInstallingUpdate}"/>
            <Button Grid.Column="2" Content="Later" Command="{Binding DismissUpdateBannerCommand}" Classes="secondary" Margin="0,0,8,0" IsEnabled="{Binding !IsInstallingUpdate}"/>
            <Button Grid.Column="3" Content="✕" Command="{Binding DismissUpdateBannerCommand}" Classes="icon" IsEnabled="{Binding !IsInstallingUpdate}"/>
          </Grid>
          <TextBlock Text="{Binding InstallUpdateError}" Foreground="{DynamicResource BrushDanger}" TextWrapping="Wrap"
                      IsVisible="{Binding InstallUpdateError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        </StackPanel>
      </Border>

      <!-- Top toolbar -->
      <Border DockPanel.Dock="Top" Padding="16,10" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto">
          <TextBlock Grid.Column="0" Text="Screens" FontWeight="Bold" FontSize="18" VerticalAlignment="Center"/>

          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" Margin="0,0,8,0" VerticalAlignment="Center">
            <Button Content="−" Classes="icon" Command="{Binding ZoomOutCommand}" ToolTip.Tip="Zoom out (Ctrl+scroll)"/>
            <Button Content="{Binding ZoomPercentText}" Classes="secondary" Command="{Binding ZoomToFitActionCommand}"
                    ToolTip.Tip="Click to fit the window" MinWidth="52"/>
            <Button Content="+" Classes="icon" Command="{Binding ZoomInCommand}" ToolTip.Tip="Zoom in (Ctrl+scroll)"/>
            <Button Content="100%" Classes="secondary" Command="{Binding ZoomResetCommand}" ToolTip.Tip="Zoom to 100%"/>
          </StackPanel>

          <Button Grid.Column="3" Content="Copy" Command="{Binding ExportToClipboardCommand}" Classes="secondary" Margin="0,0,8,0"
                  ToolTip.Tip="Copy the current export to the clipboard"/>
          <Button Grid.Column="4" Content="All formats" Command="{Binding ExportAllFormatsCommand}" Classes="secondary" Margin="0,0,8,0"
                  ToolTip.Tip="Export PNG + JPG + PDF at once"/>
          <Button Grid.Column="5" Content="{Binding ExportLabel}" Command="{Binding ExportCommand}" Classes="primary" Margin="0,0,8,0"
                  HotKey="Ctrl+E"/>
          <Button Grid.Column="6" Content="{Binding SettingsLabel}" Command="{Binding ToggleSettingsCommand}" Classes="secondary"/>
        </Grid>
      </Border>

      <Grid ColumnDefinitions="260,*,360">

        <!-- Template gallery -->
        <ScrollViewer Grid.Column="0" Padding="12">
          <StackPanel Spacing="8">
            <TextBox Text="{Binding SearchText, Mode=TwoWay}" Watermark="{Binding SearchPlaceholder}" Margin="0,0,0,4"/>

            <ItemsControl ItemsSource="{Binding RecentTemplates}" IsVisible="{Binding RecentTemplates.Count}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:TemplateManifest">
                  <Border Classes="card" Margin="0,0,0,6" Padding="8"
                          PointerPressed="OnTemplateTilePressed" Tag="{Binding}">
                    <TextBlock Text="{Binding Name}" Classes="muted" TextTrimming="CharacterEllipsis"/>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Height="1" Background="{DynamicResource BrushBorder}" Margin="0,4,0,8" IsVisible="{Binding RecentTemplates.Count}"/>

            <ItemsControl ItemsSource="{Binding Templates}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:TemplateManifest">
                  <Border Classes="card" Margin="0,0,0,8" Padding="10"
                          PointerPressed="OnTemplateTilePressed" Tag="{Binding}">
                    <StackPanel Spacing="4">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding Category}" Classes="muted"/>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl ItemsSource="{Binding Warnings}" Margin="0,12,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Message}" Classes="muted" Foreground="{DynamicResource BrushDanger}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>

        <!-- Canvas preview, with a session-only drag-to-reposition overlay
             aligned in the same coordinate space as the template. A
             LayoutTransformControl (not a plain RenderTransform) scales both
             the image and the overlay together and keeps ScrollViewer's
             scrollable extent correct at any zoom level, unlike a bare
             ScaleTransform. -->
        <Border Grid.Column="1" Name="CanvasViewport" Background="{DynamicResource BrushSurfaceElevated}" Margin="0" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1,0"
                PointerWheelChanged="OnCanvasWheelChanged">
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <LayoutTransformControl Margin="24" IsVisible="{Binding SelectedTemplate, Converter={x:Static ObjectConverters.IsNotNull}}">
              <LayoutTransformControl.LayoutTransform>
                <ScaleTransform ScaleX="{Binding EffectiveZoom}" ScaleY="{Binding EffectiveZoom}"/>
              </LayoutTransformControl.LayoutTransform>
              <Panel Width="{Binding SelectedTemplate.Canvas.Width}" Height="{Binding SelectedTemplate.Canvas.Height}">
                <Image x:Name="PreviewImageControl" Source="{Binding PreviewImage}"
                       Width="{Binding SelectedTemplate.Canvas.Width}" Height="{Binding SelectedTemplate.Canvas.Height}"/>
                <ItemsControl ItemsSource="{Binding Fields}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:FieldEditorItemViewModel">
                      <Border Canvas.Left="{Binding Field.Box.X}" Canvas.Top="{Binding Field.Box.Y}"
                              Width="{Binding Field.Box.Width}" Height="{Binding Field.Box.Height}"
                              Background="Transparent" BorderBrush="#557C3AED" BorderThickness="1" CornerRadius="2"
                              Cursor="SizeAll" Tag="{Binding}"
                              PointerPressed="OnFieldDragStart" PointerMoved="OnFieldDragMove" PointerReleased="OnFieldDragEnd"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Panel>
            </LayoutTransformControl>
          </ScrollViewer>
        </Border>

        <!-- Field editor -->
        <ScrollViewer Grid.Column="2" Padding="16">
          <StackPanel Spacing="16">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
              <TextBlock Grid.Column="0" Text="{Binding FieldsLabel}" FontWeight="Bold" VerticalAlignment="Center"/>
              <Button Grid.Column="1" Content="{Binding DuplicateLabel}" Command="{Binding DuplicateTemplateCommand}" Classes="secondary" Margin="0,0,6,0"/>
              <Button Grid.Column="2" Content="{Binding ResetLabel}" Command="{Binding ResetToDefaultsCommand}" Classes="secondary" Margin="0,0,6,0"/>
              <Button Grid.Column="3" Content="{Binding ClearAllLabel}" Command="{Binding ClearAllCommand}" Classes="secondary"/>
            </Grid>

            <CheckBox Content="Snap to grid while dragging" IsChecked="{Binding SnapToGridEnabled, Mode=TwoWay}"/>

            <ItemsControl ItemsSource="{Binding Fields}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:FieldEditorItemViewModel">
                  <StackPanel Spacing="6" Margin="0,0,0,14">
                    <TextBlock Text="{Binding Field.Label}" Classes="muted"/>
                    <TextBox Text="{Binding Value, Mode=TwoWay}" Watermark="{Binding Field.Placeholder}"
                              AcceptsReturn="{Binding Field.Multiline}" TextWrapping="Wrap"/>
                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding !IsQr}">
                      <TextBlock Grid.Column="0" Text="Will shrink to fit" Classes="muted" Foreground="{DynamicResource BrushPrimaryLight}" IsVisible="{Binding WillShrink}"/>
                      <TextBlock Grid.Column="1" Text="{Binding CounterText}" Classes="muted" HorizontalAlignment="Right" IsVisible="{Binding HasMaxLength}"/>
                    </Grid>
                    <Grid ColumnDefinitions="Auto,Auto" IsVisible="{Binding ShowColorPicker}" Margin="0,4,0,0">
                      <TextBlock Grid.Column="0" Text="Color" Classes="muted" VerticalAlignment="Center" Margin="0,0,8,0"/>
                      <TextBox Grid.Column="1" Text="{Binding ColorOverride, Mode=TwoWay}" Width="110" FontFamily="Consolas,monospace"/>
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding ShowSizePicker}" Margin="0,4,0,0">
                      <TextBlock Grid.Column="0" Text="Size" Classes="muted" VerticalAlignment="Center" Margin="0,0,8,0"/>
                      <Slider Grid.Column="1" Minimum="8" Maximum="200" Value="{Binding SizeOverride, Mode=TwoWay}"/>
                    </Grid>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </DockPanel>

    <!-- Export toast -->
    <Border Classes="toast" IsVisible="{Binding ShowToast}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <TextBlock Text="{Binding ToastMessage}" VerticalAlignment="Center"/>
        <Button Content="{Binding OpenFolderLabel}" Classes="secondary" Click="OnOpenFolderClicked"/>
        <Button Content="✕" Classes="icon" Command="{Binding DismissToastCommand}"/>
      </StackPanel>
    </Border>

    <!-- Command palette (Ctrl+K) -->
    <Border Background="{DynamicResource BrushOverlay}" IsVisible="{Binding ShowCommandPalette}" PointerPressed="OnCommandPaletteBackdropPressed">
      <Border Classes="card" Width="480" Padding="12" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,120,0,0">
        <StackPanel Spacing="8">
          <TextBox x:Name="CommandPaletteInput" Text="{Binding CommandPaletteQuery, Mode=TwoWay}" Watermark="{Binding CommandPalettePlaceholder}"/>
          <ItemsControl ItemsSource="{Binding FilteredCommandPaletteItems}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CommandPaletteItem">
                <Button Classes="secondary" Content="{Binding Label}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Margin="0,2" Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).RunCommandPaletteItemCommand}"
                        CommandParameter="{Binding}"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </Border>

    <!-- Settings / About overlay -->
    <Border Background="{DynamicResource BrushOverlay}" IsVisible="{Binding ShowSettings}">
      <Border Classes="card" Width="440" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
        <ScrollViewer MaxHeight="600">
        <StackPanel Spacing="16">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="{Binding SettingsTitleLabel}" FontWeight="Bold" FontSize="18"/>
            <Button Grid.Column="1" Content="✕" Classes="icon" Command="{Binding ToggleSettingsCommand}"/>
          </Grid>

          <StackPanel Spacing="6">
            <TextBlock Text="{Binding ThemeLabel}" Classes="muted"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Light" Classes="secondary" Click="OnThemeLightClicked"/>
              <Button Content="Dark" Classes="secondary" Click="OnThemeDarkClicked"/>
              <Button Content="System" Classes="secondary" Click="OnThemeSystemClicked"/>
            </StackPanel>
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Text="{Binding LanguageLabel}" Classes="muted"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="English" Classes="secondary" Click="OnLanguageEnglishClicked"/>
              <Button Content="中文" Classes="secondary" Click="OnLanguageChineseClicked"/>
            </StackPanel>
          </StackPanel>

          <CheckBox Content="{Binding WatermarkLabel}" IsChecked="{Binding WatermarkEnabled, Mode=TwoWay}"/>

          <StackPanel Spacing="6">
            <TextBlock Text="{Binding ExportPresetsLabel}" Classes="muted"/>
            <ItemsControl ItemsSource="{Binding ExportPresets}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,2">
                    <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="Export" Classes="secondary" Margin="0,0,6,0"
                            Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).ExportWithPresetCommand}"
                            CommandParameter="{Binding}"/>
                    <Button Grid.Column="2" Content="✕" Classes="icon"
                            Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).RemoveExportPresetCommand}"
                            CommandParameter="{Binding}"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid ColumnDefinitions="*,Auto,Auto">
              <TextBox Grid.Column="0" Text="{Binding NewPresetName, Mode=TwoWay}" Watermark="Preset name" Margin="0,0,6,0"/>
              <ComboBox Grid.Column="1" SelectedItem="{Binding NewPresetFormat, Mode=TwoWay}" Margin="0,0,6,0">
                <ComboBoxItem>png</ComboBoxItem>
                <ComboBoxItem>jpg</ComboBoxItem>
                <ComboBoxItem>pdf</ComboBoxItem>
              </ComboBox>
              <Button Grid.Column="2" Content="Add" Classes="secondary" Command="{Binding AddExportPresetCommand}"/>
            </Grid>
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="{Binding LicenseCountdownText}"/>
            <Button Content="{Binding RenewLabel}" Classes="secondary" IsVisible="{Binding ShowRenewLink}" Click="OnRenewClicked" HorizontalAlignment="Left"/>
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="{Binding CurrentVersionText}"/>
            <TextBlock Classes="muted">
              <Run Text="Last checked: "/><Run Text="{Binding LastCheckedText}"/>
            </TextBlock>
            <TextBlock Text="{Binding CheckForUpdatesResult}" Classes="secondary"/>
          </StackPanel>

          <Button Content="{Binding CheckForUpdatesLabel}" Command="{Binding CheckForUpdatesManualCommand}" Classes="secondary" HorizontalAlignment="Left"/>

          <Button Content="{Binding SignOutLabel}" Classes="secondary" Click="OnSignOutClicked" HorizontalAlignment="Left"/>
        </StackPanel>
        </ScrollViewer>
      </Border>
    </Border>
  </Panel>

</UserControl>
