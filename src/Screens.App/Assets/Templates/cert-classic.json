{
  "id": "cert-classic",
  "name": "Classic Certificate",
  "category": "Certificate",
  "image": "cert-classic.png",
  "canvas": { "width": 2000, "height": 1414 },
  "fields": [
    {
      "id": "recipient",
      "label": "Recipient Name",
      "default": "Jane Doe",
      "placeholder": "Enter full name",
      "maxLength": 40,
      "multiline": false,
      "box": { "x": 200, "y": 600, "width": 1600, "height": 160 },
      "align": "center",
      "verticalAlign": "middle",
      "font": { "family": "Playfair Display", "size": 96, "weight": "Bold", "italic": false },
      "color": "#1A1028",
      "lineHeight": 1.2,
      "letterSpacing": 0,
      "uppercase": false,
      "autoShrink": true,
      "userEditableColor": false,
      "userEditableSize": false
    },
    {
      "id": "reason",
      "label": "For",
      "default": "Outstanding Performance",
      "placeholder": "Reason for this certificate",
      "maxLength": 60,
      "multiline": false,
      "box": { "x": 300, "y": 800, "width": 1400, "height": 90 },
      "align": "center",
      "verticalAlign": "middle",
      "font": { "family": "Inter", "size": 44, "weight": "Regular", "italic": false },
      "color": "#4B3E68",
      "lineHeight": 1.2,
      "letterSpacing": 0,
      "uppercase": false,
      "autoShrink": true,
      "userEditableColor": false,
      "userEditableSize": false
    },
    {
      "id": "date",
      "label": "Date",
      "default": "January 1, 2026",
      "placeholder": "Date awarded",
      "maxLength": 30,
      "multiline": false,
      "box": { "x": 300, "y": 1180, "width": 1400, "height": 60 },
      "align": "center",
      "verticalAlign": "middle",
      "font": { "family": "Inter", "size": 32, "weight": "Regular", "italic": false },
      "color": "#786A9B",
      "lineHeight": 1.2,
      "letterSpacing": 0,
      "uppercase": false,
      "autoShrink": true,
      "userEditableColor": false,
      "userEditableSize": false
    }
  ]
}
