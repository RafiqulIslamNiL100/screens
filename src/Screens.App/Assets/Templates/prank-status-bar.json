{
  "id": "prank-status-bar",
  "name": "Prank Status Bar (Just for Fun)",
  "category": "Prank",
  "image": "prank-status-bar.png",
  "canvas": { "width": 1200, "height": 900 },
  "fields": [
    {
      "id": "caption",
      "type": "text",
      "label": "Your joke caption",
      "default": "This is a joke — your real status bar is fine.",
