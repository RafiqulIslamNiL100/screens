      "maxLength": 120,
      "multiline": true,
      "box": { "x": 110, "y": 300, "width": 980, "height": 440 },
      "align": "center",
      "verticalAlign": "middle",
      "font": { "family": "Inter", "size": 48, "weight": "Bold", "italic": false },
      "color": "#7C3AED",
      "lineHeight": 1.3,
      "letterSpacing": 0,
      "uppercase": false,
      "autoShrink": true,
      "userEditableColor": true,
      "userEditableSize": true
    }
  ]
}
