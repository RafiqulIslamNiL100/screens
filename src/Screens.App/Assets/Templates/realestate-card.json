{
  "id": "realestate-card",
  "name": "Real Estate Listing Card",
  "category": "Real Estate",
  "image": "realestate-card.png",
  "canvas": { "width": 1600, "height": 1200 },
  "fields": [
    {
      "id": "address",
      "label": "Address",
      "default": "128 Maple Street",
      "placeholder": "Property address",
      "maxLength": 40,
      "multiline": false,
      "box": { "x": 80, "y": 700, "width": 1000, "height": 90 },
      "align": "left",
      "verticalAlign": "middle",
      "font": { "family": "Inter", "size": 56, "weight": "Bold", "italic": false },
      "color": "#1A1028",
      "lineHeight": 1.2,
      "letterSpacing": 0,
      "uppercase": false,
      "autoShrink": true,
      "userEditableColor": false,
      "userEditableSize": false
    },
    {
      "id": "details",
      "label": "Details",
      "default": "3 bed · 2 bath · 1,850 sqft",
      "placeholder": "Beds, baths, size",
      "maxLength": 50,
      "multiline": false,
      "box": { "x": 80, "y": 800, "width": 1000, "height": 60 },
      "align": "left",
      "verticalAlign": "middle",
      "font": { "family": "Inter", "size": 32, "weight": "Regular", "italic": false },
      "color": "#4B3E68",
      "lineHeight": 1.2,
      "letterSpacing": 0,
      "uppercase": false,
      "autoShrink": true,
      "userEditableColor": false,
      "userEditableSize": false
    },
    {
      "id": "price",
      "label": "Price",
      "default": "$525,000",
      "placeholder": "Listing price",
      "maxLength": 20,
      "multiline": false,
      "box": { "x": 1150, "y": 1000, "width": 380, "height": 90 },
      "align": "right",
      "verticalAlign": "middle",
      "font": { "family": "Playfair Display", "size": 52, "weight": "Bold", "italic": false },
      "color": "#F8F6FC",
      "lineHeight": 1.2,
      "letterSpacing": 0,
      "uppercase": false,
      "autoShrink": true,
      "userEditableColor": false,
      "userEditableSize": false
    }
  ]
}
