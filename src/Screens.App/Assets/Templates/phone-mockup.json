      "maxLength": 60,
      "multiline": false,
      "box": { "x": 100, "y": 2450, "width": 1000, "height": 100 },
      "align": "center",
      "verticalAlign": "middle",
      "font": { "family": "Inter", "size": 44, "weight": "Bold", "italic": false },
      "color": "#1A1028",
      "lineHeight": 1.2,
      "letterSpacing": 0,
      "uppercase": false,
      "autoShrink": true,
      "userEditableColor": true,
      "userEditableSize": true
    }
  ]
