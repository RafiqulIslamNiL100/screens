{
  "id": "flyer-event",
  "name": "Event Flyer",
  "category": "Flyer",
  "image": "flyer-event.png",
  "canvas": { "width": 1500, "height": 2100 },
  "fields": [
    {
      "id": "title",
      "label": "Event Name",
      "default": "Summer Music Night",
      "placeholder": "Event title",
      "maxLength": 40,
      "multiline": true,
      "box": { "x": 120, "y": 260, "width": 1260, "height": 320 },
      "align": "left",
      "verticalAlign": "top",
      "font": { "family": "Playfair Display", "size": 90, "weight": "Bold", "italic": false },
      "color": "#F8F6FC",
      "lineHeight": 1.15,
      "letterSpacing": 0,
      "uppercase": false,
      "autoShrink": true,
      "userEditableColor": false,
      "userEditableSize": false,
      "shadow": true
    },
    {
      "id": "datetime",
      "label": "Date & Time",
      "default": "Saturday, August 15 · 7:00 PM",
      "placeholder": "When is it?",
      "maxLength": 50,
      "multiline": false,
      "box": { "x": 120, "y": 1360, "width": 1260, "height": 70 },
      "align": "left",
      "verticalAlign": "middle",
      "font": { "family": "Inter", "size": 42, "weight": "Bold", "italic": false },
      "color": "#F8F6FC",
      "lineHeight": 1.2,
      "letterSpacing": 0,
      "uppercase": false,
      "autoShrink": true,
      "userEditableColor": false,
      "userEditableSize": false
    },
    {
      "id": "location",
      "label": "Location",
      "default": "Riverside Park Amphitheater",
      "placeholder": "Venue / address",
      "maxLength": 50,
      "multiline": false,
      "box": { "x": 120, "y": 1440, "width": 1260, "height": 60 },
      "align": "left",
      "verticalAlign": "middle",
      "font": { "family": "Inter", "size": 32, "weight": "Regular", "italic": false },
      "color": "#E9E4F5",
      "lineHeight": 1.2,
      "letterSpacing": 0,
      "uppercase": false,
      "autoShrink": true,
      "userEditableColor": false,
      "userEditableSize": false
    },
    {
      "id": "host",
      "label": "Hosted By",
      "default": "Downtown Events Co.",
      "placeholder": "Organizer",
      "maxLength": 40,
      "multiline": false,
      "box": { "x": 120, "y": 1900, "width": 1260, "height": 60 },
      "align": "left",
      "verticalAlign": "middle",
      "font": { "family": "Cabin", "size": 28, "weight": "Regular", "italic": false },
      "color": "#C7BEDD",
      "lineHeight": 1.2,
      "letterSpacing": 0,
      "uppercase": true,
      "autoShrink": true,
      "userEditableColor": true,
      "userEditableSize": true
    },
    {
      "id": "ticketLink",
      "type": "qr",
      "label": "Ticket / Info Link (QR)",
      "default": "https://example.com/tickets",
      "placeholder": "URL to encode",
      "multiline": false,
      "box": { "x": 1180, "y": 1880, "width": 180, "height": 180 },
      "align": "left",
      "verticalAlign": "top",
      "font": { "family": "Inter", "size": 12, "weight": "Regular", "italic": false },
      "color": "#000000",
      "lineHeight": 1.0,
      "letterSpacing": 0,
      "uppercase": false,
      "autoShrink": false,
      "userEditableColor": false,
      "userEditableSize": false
    }
  ]
}
