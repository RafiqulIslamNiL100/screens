{
  "id": "badge-lanyard",
  "name": "ID Badge",
  "category": "Badge",
  "image": "badge-lanyard.png",
  "canvas": { "width": 1200, "height": 1800 },
  "fields": [
    {
      "id": "name",
      "label": "Full Name",
      "default": "Alex Rivera",
      "placeholder": "Attendee name",
      "maxLength": 30,
      "multiline": false,
      "box": { "x": 100, "y": 900, "width": 1000, "height": 100 },
      "align": "center",
      "verticalAlign": "middle",
      "font": { "family": "Inter", "size": 64, "weight": "Bold", "italic": false },
      "color": "#1A1028",
      "lineHeight": 1.2,
      "letterSpacing": 0,
      "uppercase": false,
      "autoShrink": true,
      "userEditableColor": false,
      "userEditableSize": false
    },
    {
      "id": "role",
      "label": "Role / Title",
      "default": "Speaker",
      "placeholder": "e.g. Attendee, Staff, Speaker",
      "maxLength": 30,
      "multiline": false,
      "box": { "x": 100, "y": 1010, "width": 1000, "height": 70 },
      "align": "center",
      "verticalAlign": "middle",
      "font": { "family": "Cabin", "size": 40, "weight": "Regular", "italic": false },
      "color": "#6D28D9",
      "lineHeight": 1.2,
      "letterSpacing": 0,
      "uppercase": true,
      "autoShrink": true,
      "userEditableColor": false,
      "userEditableSize": false
    },
    {
      "id": "company",
      "label": "Company",
      "default": "Acme Events",
      "placeholder": "Organization",
      "maxLength": 30,
      "multiline": false,
      "box": { "x": 100, "y": 1120, "width": 1000, "height": 60 },
      "align": "center",
      "verticalAlign": "middle",
      "font": { "family": "Inter", "size": 32, "weight": "Regular", "italic": false },
      "color": "#786A9B",
      "lineHeight": 1.2,
      "letterSpacing": 0,
      "uppercase": false,
      "autoShrink": true,
      "userEditableColor": false,
      "userEditableSize": false
    }
  ]
}
