{
  "id": "award-employee",
  "name": "Employee of the Month Award",
  "category": "Award",
  "image": "award-employee.png",
  "canvas": { "width": 1600, "height": 1200 },
  "fields": [
    {
      "id": "name",
      "label": "Employee Name",
      "default": "Jordan Smith",
      "placeholder": "Who is being recognized?",
      "maxLength": 30,
      "multiline": false,
      "box": { "x": 200, "y": 640, "width": 1200, "height": 110 },
      "align": "center",
      "verticalAlign": "middle",
      "font": { "family": "Playfair Display", "size": 72, "weight": "Bold", "italic": false },
      "color": "#1A1028",
      "lineHeight": 1.2,
      "letterSpacing": 0,
      "uppercase": false,
      "autoShrink": true,
      "userEditableColor": false,
      "userEditableSize": false
    },
    {
      "id": "period",
      "label": "Period",
      "default": "Employee of the Month — August 2026",
      "placeholder": "e.g. August 2026",
      "maxLength": 50,
      "multiline": false,
      "box": { "x": 200, "y": 760, "width": 1200, "height": 70 },
      "align": "center",
      "verticalAlign": "middle",
      "font": { "family": "Inter", "size": 34, "weight": "Regular", "italic": false },
      "color": "#6D28D9",
      "lineHeight": 1.2,
      "letterSpacing": 0,
      "uppercase": false,
      "autoShrink": true,
      "userEditableColor": false,
      "userEditableSize": false
    },
    {
      "id": "note",
      "label": "Note",
      "default": "For exceptional teamwork and dedication.",
      "placeholder": "Why they earned it",
      "maxLength": 80,
      "multiline": true,
      "box": { "x": 300, "y": 950, "width": 1000, "height": 100 },
      "align": "center",
      "verticalAlign": "top",
      "font": { "family": "Inter", "size": 28, "weight": "Regular", "italic": false },
      "color": "#4B3E68",
      "lineHeight": 1.3,
      "letterSpacing": 0,
      "uppercase": false,
      "autoShrink": true,
      "userEditableColor": false,
      "userEditableSize": false
    }
  ]
}
