{
  "id": "price-poster",
  "name": "Product Price Poster",
  "category": "Poster",
  "image": "price-poster.png",
  "canvas": { "width": 1600, "height": 1600 },
  "fields": [
    {
      "id": "product",
      "label": "Product Name",
      "default": "House Blend Coffee",
      "placeholder": "What are you selling?",
      "maxLength": 30,
      "multiline": false,
      "box": { "x": 150, "y": 70, "width": 1300, "height": 120 },
      "align": "center",
      "verticalAlign": "middle",
      "font": { "family": "Inter", "size": 56, "weight": "Bold", "italic": false },
      "color": "#F8F6FC",
      "lineHeight": 1.2,
      "letterSpacing": 0,
      "uppercase": false,
      "autoShrink": true,
      "userEditableColor": false,
      "userEditableSize": false
    },
    {
      "id": "price",
      "label": "Price",
      "default": "$4.99",
      "placeholder": "$0.00",
      "maxLength": 12,
      "multiline": false,
      "box": { "x": 500, "y": 850, "width": 600, "height": 220 },
      "align": "center",
      "verticalAlign": "middle",
      "font": { "family": "Playfair Display", "size": 140, "weight": "Bold", "italic": false },
      "color": "#F8F6FC",
      "lineHeight": 1.0,
      "letterSpacing": 0,
      "uppercase": false,
      "autoShrink": true,
      "userEditableColor": false,
      "userEditableSize": false
    },
    {
      "id": "subtext",
      "label": "Subtext",
      "default": "Limited time offer",
      "placeholder": "Additional detail",
      "maxLength": 30,
      "multiline": false,
      "box": { "x": 400, "y": 1420, "width": 800, "height": 80 },
      "align": "center",
      "verticalAlign": "middle",
      "font": { "family": "Inter", "size": 36, "weight": "Regular", "italic": false },
      "color": "#4B3E68",
      "lineHeight": 1.2,
      "letterSpacing": 0,
      "uppercase": false,
      "autoShrink": true,
      "userEditableColor": false,
      "userEditableSize": false
    }
  ]
}
