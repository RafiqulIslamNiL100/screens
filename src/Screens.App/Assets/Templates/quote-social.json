{
  "id": "quote-social",
  "name": "Social Quote Post",
  "category": "Social",
  "image": "quote-social.png",
  "canvas": { "width": 1600, "height": 1600 },
  "fields": [
    {
      "id": "quote",
      "label": "Quote",
      "default": "Small steps every day lead to big change.",
      "placeholder": "The quote text",
      "maxLength": 160,
      "multiline": true,
      "box": { "x": 200, "y": 480, "width": 1200, "height": 620 },
      "align": "left",
      "verticalAlign": "top",
      "font": { "family": "Playfair Display", "size": 64, "weight": "Regular", "italic": true },
      "color": "#F8F6FC",
      "lineHeight": 1.3,
      "letterSpacing": 0,
      "uppercase": false,
      "autoShrink": true,
      "userEditableColor": false,
      "userEditableSize": false
    },
    {
      "id": "author",
      "label": "Author",
      "default": "— Maya Chen",
      "placeholder": "Who said it?",
      "maxLength": 40,
      "multiline": false,
      "box": { "x": 200, "y": 1200, "width": 1200, "height": 70 },
      "align": "left",
      "verticalAlign": "middle",
      "font": { "family": "Inter", "size": 36, "weight": "Bold", "italic": false },
      "color": "#A78BFA",
      "lineHeight": 1.2,
      "letterSpacing": 0,
      "uppercase": false,
      "autoShrink": true,
      "userEditableColor": false,
      "userEditableSize": false
    }
  ]
}
